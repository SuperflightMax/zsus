# Environment
APP_ENV=dev
LOG_LEVEL=info

# Paths
STORAGES_ROOT=./storages
CONFIG_PATH=./config/default.yaml

# LLM
OPENAI_API_KEY=put-your-key-here
OPENAI_MODEL=gpt-4.1
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# PERSONAL
DEFAULT_STORAGE=bbs
STORAGE_TITLE="Склад"
STORAGE_SUBTITLE="ШІ оператор online"

# HTTP
ZSUS_HTTP_HOST=0.0.0.0
ZSUS_HTTP_PORT=8123

# Web Speech (browser voice input)
AUDIO_WEB_SPEECH_ENABLED=true
AUDIO_AUTOSEND=true
AUDIO_WEB_SPEECH_LANG=uk-UA
AUDIO_WEB_SPEECH_MAX_SECONDS=30
